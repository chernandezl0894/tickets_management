# Runtime environment: local | staging | production
ENVIRONMENT=local

# Required: PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/tickets_management

# Required: Redis connection string
REDIS_URL=redis://localhost:6379/0

# Optional for now: Telegram bot token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Optional for now: JWT signing secret
JWT_SECRET=your-jwt-secret

# OTP time-to-live, in seconds
OTP_TTL_SECONDS=300
